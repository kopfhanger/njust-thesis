== 本文主要内容和组织结构
=== 论文结构框架

全文按“提出问题—建模与推断—验证与应用”三个阶段展开，各章的分工可以用一张框架图概括。
图中每一层都对应一个可以独立检查的产出：公式与参数表、数值实验、评估指标与工程边界。
真实论文可把本图替换为按自己章节划分的结构图，保持同样的层次和箭头方向即可。

#let 结构框架 = canvas({
  import draw: *
  let box-w = 7.6
  let box-h = 1.10
  let gap = 1.25
  let ink = 0.8pt
  let chapters = (
    ("第 1 章　绪论", "研究问题、技术路线与全文框架", "问题定义 · 技术路线 · 符号约定", rgb("#eaf2f8")),
    ("第 2 章　超音速喷射的概率动力学", "状态方程、参数分布与数学工具", "状态模型 · 参数表 · 公式体系", rgb("#e8f8f5")),
    ("第 3 章　时间旅行的概率动力学", "理论基础、分支模型与转移概率", "理论基础 · 分支模型 · 概率推断", rgb("#e8f8f5")),
    ("第 4 章　两者的异构耦合关系", "数值离散、参数估计与模拟结果", "离散格式 · 参数估计 · 数值证据", rgb("#fef9e7")),
    ("第 5 章　应用前景与评估", "处理算法、评估指标与工程边界", "处理算法 · 评价指标 · 工程边界", rgb("#fef9e7")),
    ("第 6 章　总结与展望", "量化结论、局限性与后续工作", "量化结论 · 局限性 · 后续工作", rgb("#eaf2f8")),
  )
  for (i, item) in chapters.enumerate() {
    let (title, sub, output, fill-color) = item
    let y = 6.5 * gap - i * gap
    rect((0, y), (box-w, y + box-h), fill: fill-color, stroke: ink,
      radius: 0.06, name: "chapter-" + str(i))
    content((box-w / 2, y + box-h * 0.77), text(size: 10.2pt, title))
    content((box-w / 2, y + box-h * 0.49), text(size: 8.5pt, fill: luma(30%), sub))
    content((box-w / 2, y + box-h * 0.18), text(size: 7.4pt, fill: luma(38%), output))
    if i > 0 {
      line("chapter-" + str(i - 1), "chapter-" + str(i), stroke: ink,
        mark: (end: "stealth", fill: black, stroke: (paint: black, thickness: ink)))
    }
    if i in (0, 1, 3) {
      let stage = ("提出问题", "建模与推断", "验证与应用").at(if i == 0 { 0 } else if i == 1 { 1 } else { 2 })
      let span = if i == 1 { 2 } else { 1 }
      line((box-w + 0.5, y + box-h / 2), (box-w + 0.9, y + box-h / 2), stroke: (paint: luma(45%), thickness: 0.6pt))
      content((box-w + 1.25, y + box-h / 2 + (span - 1) * gap / 2), text(size: 9pt, fill: luma(25%))[#stage])
    }
  }
  for i in range(2) {
    line((box-w + 0.85, 6.5 * gap - i * gap + box-h / 2), (box-w + 0.85, 6.5 * gap - (i + 1) * gap + box-h / 2),
      stroke: (paint: luma(45%), thickness: 0.6pt))
  }
})

#figure(align(center, 结构框架), caption: [论文结构框架]) <fig:framework>



全文共分六章，各章的分工如下。

第一章为绪论。本章说明超音速射流与时间旅行两个问题各自的研究背景与现状，指出它们在不确定
度量化上的共同缺口，并给出本文的研究问题、技术路线与结构框架（@fig:framework）。本章同时
约定全文的符号与量纲，后续章节不再重复定义。

第二章建立超音速喷射的概率动力学模型，并集中给出数学工具与公式版式。2.1 节给出喷射过程的
基本假设、概率分布与实验指标；2.2 节把矩阵与范数、级数积分与极限、微分算子、概率分布与
贝叶斯更新等工具集中列出，便于后续章节引用；2.3 节给出公式版式与编号规则，包括分段函数、
矩阵、方程组、大算符与上下标注等写法。

第三章讨论时间旅行的概率动力学。3.1 节给出相对论与量子力学两方面的理论基础；3.2 节把时间
分支抽象为带参数的转移概率模型，并给出分段定义与方程组写法；3.3 节补充数学分析基础，包括
导数与泰勒展开、最优性与 KKT 条件、特征分解与奇异值分解，以及常用的不等式与误差上界。

第四章研究两个子系统的异构耦合关系。4.1 节给出综合分析框架与结构关系图；4.2 节给出参数响应
曲线与多子图排版示例；4.3 节讨论数值离散与误差分析，包括有限差分格式、收敛阶与 Richardson
外推、CFL 条件、最小二乘与正则化，以及蒙特卡洛与重要性采样；4.4 节讨论模型适用范围与误差
来源。

第五章讨论应用前景与工程化边界。5.1 节给出食品加工、时空导航与数据处理三个应用场景，并给出
算法框与流程图；5.2 节给出数据处理与评估方法，包括滤波与谱分析、不确定度合成、复杂度与
终止判据；5.3 节讨论工程限制与可复现性要求。

第六章总结全文。6.1 节给出主要结论与量化表达方式；6.2 节说明局限性；6.3 节给出后续研究
方向与模板使用建议。
